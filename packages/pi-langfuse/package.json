{
	"name": "@narumitw/pi-langfuse",
	"version": "0.50.1",
	"description": "Pi extension that traces LLM generations and tool activity to Langfuse.",
	"type": "module",
	"license": "MIT",
	"private": false,
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"langfuse",
		"observability",
		"tracing"
	],
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"piExtension": {
		"lifecycle": "stable"
	},
	"scripts": {
		"check": "biome check . && npm run typecheck",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@earendil-works/pi-coding-agent": "0.84.2",
		"@types/node": "26.2.0",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"@langfuse/otel": "^5.10.1",
		"@langfuse/tracing": "^5.10.1",
		"@narumitw/pi-tui-kit": "^0.56.0",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
		"@opentelemetry/sdk-trace-base": "^2.10.0",
		"@opentelemetry/sdk-trace-node": "^2.10.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/narumiruna/pi-extensions",
		"directory": "packages/pi-langfuse"
	}
}
